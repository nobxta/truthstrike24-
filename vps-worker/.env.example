# ─── Copy to .env on the VPS ───
# Use the SAME Neon DB URL as Vercel
DATABASE_URL=postgresql://neondb_owner:xxx@xxx.aws.neon.tech/neondb?sslmode=require

# AI providers (need at least one)
ANTHROPIC_API_KEY=sk-ant-api03-xxxxx
OPENAI_API_KEY=sk-proj-xxxxx
GROQ_API_KEY=gsk_xxxxx

# Image generation (required)
WAVESPEED_API_KEY=wsk_live_xxxxx

# Brand watermark (optional)
NEXT_PUBLIC_WATERMARK_URL=https://res.cloudinary.com/.../logo.png
