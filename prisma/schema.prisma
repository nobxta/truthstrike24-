generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  posts        Post[]
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  color     String
  emoji     String
  posts     Post[]
  createdAt DateTime @default(now())
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  posts     PostTag[]
  createdAt DateTime  @default(now())
}

model Post {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  summary         String
  content         String    @db.Text
  featuredImage   String
  seoTitle        String
  metaDescription String
  status          String    @default("draft")
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  authorId        String
  author          User      @relation(fields: [authorId], references: [id])
  categoryId      String
  category        Category  @relation(fields: [categoryId], references: [id])
  tags            PostTag[]
  isAgentPost     Boolean   @default(false)
  isBreaking      Boolean   @default(false)
  isPinned        Boolean   @default(false)
  imagePrompt     String?   @db.Text
  imageStatus     String    @default("none") // "none" | "pending" | "done" | "failed"
  keywords        String    @default("") // comma-separated SEO keywords for tagging
}

model PostTag {
  postId String
  tagId  String
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model AgentSettings {
  id              String   @id @default("singleton")
  model           String   @default("claude-sonnet-4-6")
  enabled         Boolean  @default(true)
  topicFocus      String   @default("Indian news, politics, sports, tech, entertainment")
  // AI provider for news posts: "anthropic" | "openai" | "groq"
  postProvider    String   @default("anthropic")
  // AI provider for chat enhancement: "anthropic" | "openai" | "groq"
  chatProvider    String   @default("groq")
  chatModel       String   @default("llama-3.3-70b-versatile")
  // Image generation
  imageModel      String   @default("wavespeed-ai/flux-schnell")
  watermarkUrl    String   @default("")
  useWebSearch    Boolean  @default(false)
  // Article word limit (target length)
  wordLimit       Int      @default(600)
  // Optional: extra writing instructions
  writingStyle    String   @default("Professional journalism with specific names, dates, statistics, and quotes from real people. No filler. No 'experts say' without naming them.")
  // Posting interval (minutes between articles)
  postIntervalMinutes Int @default(60)
  // Auto-reply settings
  autoReplyEnabled Boolean @default(true)
  autoReplyMinutes Int     @default(60)
  // Image agent toggle (controls AUTO-poster images, default OFF to save credits)
  imageGenEnabled Boolean  @default(false)

  // ─── ON-DEMAND generator (separate from auto-poster) ───
  // Used when you click "Generate Now" in admin. Defaults to Anthropic Claude
  // with web search + images for premium quality.
  onDemandProvider       String  @default("anthropic")
  onDemandModel          String  @default("claude-sonnet-4-5")
  onDemandImagesEnabled  Boolean @default(true)
  onDemandWebSearch      Boolean @default(true)
  lastOnDemandAt         DateTime?

  updatedAt       DateTime @updatedAt
}

model AgentLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  model     String
  status    String
  title     String?
  error     String?
}

// ─── Browser Push Notification Subscribers ───
model PushSubscription {
  id            String   @id @default(cuid())
  endpoint      String   @unique @db.Text
  p256dh        String   @db.Text
  auth          String   @db.Text
  userAgent     String?  @db.Text
  ipAddress     String?
  country       String?  // 2-letter ISO from cf-ipcountry header
  city          String?
  status        String   @default("active") // active | unsubscribed | failed
  failureCount  Int      @default(0)
  lastSentAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, createdAt])
}

// ─── Analytics: Page Views ───
model PostView {
  id        String   @id @default(cuid())
  postId    String?  // null = homepage / category / search / etc
  pathname  String   // /tesla-news-2026 or /category/politics
  ip        String?
  country   String?  // 2-letter ISO
  city      String?
  referer   String?  @db.Text
  userAgent String?  @db.Text
  isBot     Boolean  @default(false)
  sessionId String?  // anonymous session for dedup
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([postId, createdAt])
  @@index([pathname])
  @@index([country])
}

// ─── Cookie Consent log (audit trail) ───
model CookieConsent {
  id            String   @id @default(cuid())
  sessionId     String   @unique
  ip            String?
  country       String?
  analytics     Boolean  @default(false)
  marketing     Boolean  @default(false)
  notifications Boolean  @default(false)
  acceptedAt    DateTime @default(now())
  userAgent     String?  @db.Text
}

// ─── Newsletter Subscribers ───
model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  source       String   @default("footer") // "footer" | "popup" | "sidebar" | etc
  status       String   @default("active") // "active" | "unsubscribed" | "bounced"
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  unsubToken   String   @unique @default(cuid())

  @@index([status, createdAt])
  @@index([email])
}

model NewsletterCampaign {
  id            String   @id @default(cuid())
  subject       String
  preHeader     String   @default("")
  html          String   @db.Text
  fromRole      String   @default("news")
  sentToCount   Int      @default(0)
  failedCount   Int      @default(0)
  testMode      Boolean  @default(false)
  createdById   String
  createdAt     DateTime @default(now())
  events        NewsletterEvent[]

  @@index([createdAt])
}

model NewsletterEvent {
  id          String              @id @default(cuid())
  campaignId  String
  campaign    NewsletterCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  type        String              // "open" | "click"
  email       String?
  url         String?             // populated for clicks
  ip          String?
  userAgent   String?             @db.Text
  createdAt   DateTime            @default(now())

  @@index([campaignId, type])
  @@index([createdAt])
}

model AIUsage {
  id            String   @id @default(cuid())
  provider      String   // "anthropic" | "openai" | "groq"
  model         String
  purpose       String   // "post" | "chat_enhance" | "auto_reply" | "other"
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  totalTokens   Int      @default(0)
  costUsd       Float    @default(0)
  durationMs    Int      @default(0)
  success       Boolean  @default(true)
  error         String?
  createdAt     DateTime @default(now())
}

// ─── Generation Job Queue (frontend → VPS worker pickup) ───
// User clicks Generate → Vercel creates job (instant) → VPS picks it up
// → does the slow AI work → updates job → frontend polls and shows result.
model GenerationJob {
  id           String   @id @default(cuid())
  status       String   @default("pending") // pending | running | done | failed
  // Input params (what to generate)
  context      String   @db.Text
  wordLimit    Int      @default(600)
  provider     String   @default("groq")
  model        String   @default("llama-3.3-70b-versatile")
  useWebSearch Boolean  @default(false)
  generateImage Boolean @default(true)
  imageModel   String   @default("wavespeed-ai/flux-schnell")
  // Output (filled in by VPS worker)
  resultJson   String?  @db.Text // Article JSON: title, slug, summary, content, etc
  imageUrl     String?
  errorMsg     String?
  // Telemetry
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Float    @default(0)
  durationMs   Int      @default(0)
  // Job type: "article" (news post) | "custom_page" (full landing page)
  jobType      String   @default("article")
  // For custom_page jobs — which theme key from lib/designs.ts
  themeKey     String?
  // Auth
  userId       String?  // who requested it
  createdAt    DateTime @default(now())
  startedAt    DateTime?
  completedAt  DateTime?

  @@index([status, createdAt])
}

model CustomPage {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  headline    String   @default("")
  subheadline String   @default("")
  content     String   @db.Text
  design      String   @default("cyber-noir")
  heroImage   String   @default("")
  image2      String   @default("")
  logoUrl     String   @default("")
  ctaText     String   @default("")
  ctaUrl      String   @default("")
  sections    String   @default("[]") @db.Text
  published   Boolean  @default(false)
  metaTitle   String   @default("")
  metaDesc    String   @default("")
  customCss   String   @default("") @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  disputes    DisputeChat[]
}

// ─── Dispute / Report Chat System ───

model DisputeChat {
  id             String   @id @default(cuid())
  email          String
  name           String
  subject        String
  description    String   @db.Text
  secretToken    String   @unique @default(cuid())
  customPageId   String?
  customPage     CustomPage? @relation(fields: [customPageId], references: [id], onDelete: SetNull)
  customPageSlug String   @default("")
  status         String   @default("open")
  messages       DisputeMessage[]
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model RateLimit {
  key         String   @id
  count       Int      @default(1)
  windowStart DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ErrorLog {
  id          String   @id @default(cuid())
  source      String   // "api" | "worker" | "newsletter" | "push" | "ai" | "other"
  route       String?  // e.g. "/api/posts" or "vps-worker/agent.js"
  message     String   @db.Text
  stack       String?  @db.Text
  severity    String   @default("error") // "warn" | "error" | "fatal"
  metadata    String?  @db.Text // JSON-stringified extra context
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([source])
  @@index([resolved])
}

model DisputeMessage {
  id        String      @id @default(cuid())
  chatId    String
  chat      DisputeChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender    String      // "user" | "admin"
  content   String      @db.Text
  imageUrl  String      @default("")
  createdAt DateTime    @default(now())
}
