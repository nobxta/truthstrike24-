# ── Database (Neon PostgreSQL or any Postgres) ──
DATABASE_URL=

# ── NextAuth ──
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://your-domain.vercel.app

# ── Cloudinary (image uploads) ──
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ── AI Providers ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# ── WaveSpeed.ai (image generation) ──
WAVESPEED_API_KEY=

# ── Brand watermark (public PNG URL) ──
NEXT_PUBLIC_WATERMARK_URL=

# ── Cron secret (for cron-job.org → /api/agent/post) ──
CRON_SECRET=

# ── SMTP (dispute chat emails) ──
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Telegram contact link ──
NEXT_PUBLIC_TELEGRAM_USERNAME=

# ── Public site URL (used in dispute email links) ──
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# ── Optional ──
NEXT_PUBLIC_GA_ID=
UNSPLASH_ACCESS_KEY=
